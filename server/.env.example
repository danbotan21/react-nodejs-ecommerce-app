MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Ecommerce-App
JWT_SECRET=any-long-random-string
PORT=8000
# Frontend address (CORS and Stripe redirects)
CLIENT_URL=http://localhost:3000
# Optional: a Stripe *test* key (sk_test_...). Without it, checkout confirms orders without payment.
STRIPE_SECRET_KEY=
